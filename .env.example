# ==============================================================================
# PROJECT SETU — Master Environment Configuration Template
# ==============================================================================
# Note: Copy this file to .env and replace placeholder values with your real secrets.
# NEVER commit real passwords, JWT secrets, or production credentials to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. RELATIONAL POSTGRESQL DATABASE (PRISMA ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_setu?schema=public

# ------------------------------------------------------------------------------
# 3. JWT & CRYPTOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically strong 256-bit key in production: openssl rand -base64 32
JWT_SECRET=your_jwt_strong_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS & NETWORK ACCESS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. PYTHON FASTAPI AI MICROSERVICE & INTERNAL SECURITY
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.85
AI_REQUEST_TIMEOUT_MS=5000
SETU_INTERNAL_API_KEY=your_internal_microservice_shared_secret_key_2026

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE & ATTACHMENTS
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760
