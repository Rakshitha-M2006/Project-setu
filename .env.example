# ==============================================================================
# PROJECT SETU — Master Environment Configuration Template
# AI-Powered Government Services & Grievance Management Platform
# ==============================================================================
# Copy this file to .env and configure values according to your environment.
# NEVER commit real passwords, API secrets, or private keys to source control.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | production | test
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (POSTGRESQL 14+ WITH PRISMA ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_setu?schema=public&connection_limit=20"

# Docker Database Credentials (Used by docker-compose)
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=project_setu

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (HS256)
# ------------------------------------------------------------------------------
# In production, generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_strong_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# In development: Comma-separated localhost ports
# In production: Your verified gov domains e.g. https://setu.gov.in,https://admin.setu.gov.in
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. PYTHON FASTAPI AI MICROSERVICE & INTER-SERVICE SECURITY
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.85
AI_REQUEST_TIMEOUT_MS=5000
INTERNAL_API_SECRET=your_internal_microservice_shared_secret_key_2026

# ------------------------------------------------------------------------------
# 6. SECURE DOCUMENT STORAGE & ATTACHMENTS
# ------------------------------------------------------------------------------
# Options: LOCAL | S3_COMPATIBLE | AZURE_BLOB | GCS
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# S3 / Cloud Storage Settings (Only if STORAGE_PROVIDER=S3_COMPATIBLE)
# S3_BUCKET_NAME=setu-documents-prod
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your_s3_access_key
# S3_SECRET_ACCESS_KEY=your_s3_secret_key

# ------------------------------------------------------------------------------
# 7. FRONTEND VITE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Relative path when proxied through NGINX or direct backend URL in development
VITE_API_BASE_URL=http://localhost:5000/api/v1
