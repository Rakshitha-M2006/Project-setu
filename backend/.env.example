# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection String (Strictly MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/project_setu_db"

# JWT Authentication Secrets
JWT_SECRET="setu_jwt_super_secret_development_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Internal AI Microservice URL
AI_SERVICE_URL="http://localhost:8000"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
