# ==============================================================================
# PROJECT SETU - Backend Environment Variables
# Enterprise PostgreSQL Relational Database Configuration
# ==============================================================================

# Server Environment Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=info

# PostgreSQL Database Connection String (Strictly PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_setu?schema=public"

# JWT Authentication Secrets
JWT_SECRET="setu_jwt_super_secret_development_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Internal Python FastAPI AI Microservice URL & Triage Configuration
AI_SERVICE_URL="http://localhost:8000"
AI_CONFIDENCE_THRESHOLD=0.85
AI_REQUEST_TIMEOUT_MS=5000

# CORS Configuration
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
