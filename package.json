{
  "name": "project-setu",
  "version": "1.0.0",
  "description": "PROJECT SETU - AI-Powered Government Services & Grievance Management Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "build": "npm run build:backend && npm run build:frontend",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm run start",
    "start:ai": "cd ai-service && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ai": "cd ai-service && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:migrate": "cd backend && npm run prisma:migrate",
    "prisma:migrate:prod": "cd backend && npx prisma migrate deploy",
    "prisma:seed": "cd backend && npm run prisma:seed",
    "prisma:studio": "cd backend && npm run prisma:studio",
    "lint:all": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "docker:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f"
  },
  "keywords": [
    "govtech",
    "grievance-redressal",
    "public-services",
    "ai-nlp",
    "react",
    "nodejs",
    "express",
    "fastapi",
    "postgresql",
    "prisma"
  ],
  "author": "PROJECT SETU Engineering Team",
  "license": "UNLICENSED"
}
